; waveserve.def - the server's default settings. The server zip carries
; them as waveserve.ini (make server-release), and in a checkout the
; server makes waveserve.ini from this file the first time it starts:
; that one is yours to change, and stays out of git. One setting per
; line, in alphabetical order, with what it does above it.
; tools/waveserve.py reads waveserve.ini from the folder above it (or
; --config FILE); a flag on the command line, or a variable to make
; waveserve, overrides a line for one run. All but four lines are what
; the bare command line falls back to without this file; cd=, exodos=,
; max_mb= and netdrive= say where they differ. A path may start with ~,
; and a relative one is taken from this file's folder. The server's own
; folders are under ~/.wave86 (cd, thumbs, torrent); one still at its
; place from before 0.6 (~/wave86-cd, ~/wave86-thumbs, ~/wave86-torrent)
; is moved there when the server starts.

; Where the pieces fetched from the torrent are kept (see torrent=).
cache=~/.wave86/torrent

; 1 lists the games that need a CD image - their discs come along, or
; stay on the server; 0 leaves them out. Without this file they are
; out unless --cd is given.
cd=1

; The eXoDOS collection: the folder with eXo/eXoDOS in it (an eXoDOS
; Lite install will do). Empty, with torrent= set, everything comes
; from the torrent. Without this file the folder is given on the
; command line (or --torrent, or --tdc), or the server does not start.
exodos=

; 1 asks, when the server starts on a terminal, where eXoDOS is - on
; demand through a torrent, or a local install - writes the answer into
; torrent= or exodos= here (emptying the other, so a local install turns
; the torrent off) and sets this to 0. It comes as 1; --setup asks
; again.
firstrun=1

; 1 runs without the console, logging to the terminal - what happens by
; itself when there is no terminal.
headless=0

; The address WAVE86 reaches the server on - one of this machine's, when
; it has several; empty listens on all of them.
interface=

; A file the log is appended to as well; empty for none.
log=

; Games bigger than this many MB, unpacked and without their disc, are
; left out of the list. Without this file the limit is 30 (--max-mb).
max_mb=200

; Where the NetDrive volumes for playing games off the server are kept;
; the NetDrive server (netdrive/ in the server zip, build/netdrive in a
; checkout) is started with them. Empty: no
; NetDrive, no playing off the server. Without this file there is none
; unless --netdrive DIR is given.
netdrive=~/.wave86/cd

; The UDP port the NetDrive server listens on.
netdrive_port=2002

; The NetDrive server binary; empty: build/netdrive, the one in netdrive/
; for this machine, else one on the PATH.
netdrive_server=

; The TCP port WAVE86 connects to: server= in WAVE86.INI names it.
port=8086

; Seconds between re-reading the collection.
rescan=300

; A Total DOS Collection folder (the <year> folders), instead or as well.
tdc=

; Where the pictures made for the details pane are kept; empty sends no
; pictures.
thumbs=~/.wave86/thumbs

; The collection's .torrent: every game in it is listed, and one that is
; not on the disk is fetched from the swarm when somebody asks for it.
; eXoDOS.torrent is the one that comes with WAVE86, next to this file in
; the server zip (a checkout's waveserve.ini points at exodos/eXoDOS.torrent).
; Needs libtorrent: brew install libtorrent-rasterbar, sudo apt install
; python3-libtorrent, or pip install -r requirements.txt. Empty: no torrent.
torrent=eXoDOS.torrent

; Peers to talk to at most.
torrent_connections=200

; 1 finds peers through the DHT as well as the tracker; 0 asks only the
; tracker (a private torrent allows nothing else anyway).
torrent_dht=1

; What we take from the swarm, in KB/s at most; 0 for no limit.
torrent_download=0

; The address, or the network device (en0, eth0), the swarm side listens
; and calls out on; empty for all of this machine's.
torrent_interface=

; The TCP and UDP port other peers reach us on.
torrent_port=6881

; 1 asks the router (UPnP, NAT-PMP) to let peers in on that port; 0 only
; calls out, which is enough to fetch.
torrent_portmap=0

; What we give back to the swarm, in KB/s at most: 0 for no limit, off
; for no uploading at all.
torrent_upload=1024

; A folder of extra files for WAVEGET UPDATE (a WAVE86.INI, drivers...);
; the built programs go out anyway. Empty for none.
update=
